<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="lekiwi_ros2_control" params="name use_fake_hardware">

        <ros2_control name="${name}" type="system">
            <hardware>
                <xacro:if value="${use_fake_hardware}">
                    <plugin>mock_components/GenericSystem</plugin>
                    <param name="fake_sensor_commands">false</param>
                    <param name="state_following_offset">0.0</param>
                    <param name="calculate_dynamics">true</param>
                </xacro:if>
                <xacro:unless value="${use_fake_hardware}">
                    <plugin>joint_state_topic_hardware_interface/JointStateTopicSystem</plugin>
                    <param name="joint_commands_topic">/topic_based_joint_commands</param>
                    <param name="joint_states_topic">/topic_based_joint_states</param>
                    <param name="sum_wrapped_joint_states">true</param>
                </xacro:unless>
            </hardware>
            <joint name="joint7">
                <command_interface name="velocity"/>
                <state_interface name="position">
                  <param name="initial_value">0</param>
                </state_interface>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
                <param name="motor_id">7</param>
                <param name="direction">-1</param>
                <param name="control_mode">velocity</param>
            </joint>
            <joint name="joint8">
                <command_interface name="velocity"/>
                <state_interface name="position">
                  <param name="initial_value">0</param>
                </state_interface>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
                <param name="motor_id">8</param>
                <param name="direction">-1</param>
                <param name="control_mode">velocity</param>
            </joint>
            <joint name="joint9">
                <command_interface name="velocity"/>
                <state_interface name="position">
                  <param name="initial_value">0</param>
                </state_interface>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
                <param name="motor_id">9</param>
                <param name="direction">-1</param>
                <param name="control_mode">velocity</param>
            </joint>

            <joint name="STS3215_03a_v1_Revolute_45">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">0</param>
                </state_interface>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
                <param name="control_mode">position</param>
            </joint>
            <joint name="STS3215_03a_v1_1_Revolute_49">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">0</param>
                </state_interface>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
                <param name="control_mode">position</param>
            </joint>
            <joint name="STS3215_03a_v1_2_Revolute_51">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">0</param>
                </state_interface>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
                <param name="control_mode">position</param>
            </joint>
            <joint name="STS3215_03a_v1_3_Revolute_53">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">0</param>
                </state_interface>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
                <param name="control_mode">position</param>
            </joint>
            <joint name="STS3215_03a_Wrist_Roll_v1_Revolute_55">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">0</param>
                </state_interface>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
                <param name="control_mode">position</param>
            </joint>
            <joint name="STS3215_03a_v1_4_Revolute_57">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">0</param>
                </state_interface>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
                <param name="control_mode">position</param>
            </joint>

        </ros2_control>

  </xacro:macro>

</robot>
